parameters:
	ignoreErrors:
		-
			message: '#^Error suppression via "@" should not be used\.$#'
			identifier: ergebnis.noErrorSuppression
			count: 1
			path: ../../Classes/OpenApi/JsonSchemaMapper.php

		-
			message: '#^Error suppression via "@" should not be used\.$#'
			identifier: ergebnis.noErrorSuppression
			count: 2
			path: ../Functional/Fixtures/Extensions/routing_benchmark/Resources/Private/Scripts/benchmark.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertSame\(\) with array\{n\: 1\} and array\{n\: 1\} will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: ../Unit/Http/RequestBodyTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertSame\(\) with KonradMichalik\\Typo3Routing\\Cache\\CacheBypassGuard and KonradMichalik\\Typo3Routing\\Cache\\CacheBypassGuard will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: ../Unit/Middleware/DispatcherServicesTest.php

		# Route targets declared with #[Route]. The dead code detector only knows routes from Configuration/*.php.
		-
			message: '#^Unused KonradMichalik\\Typo3Routing\\Controller\\SwaggerUiController\:\:(openApiJson|docs) \(all usages excluded by tests excluder\)$#'
			identifier: shipmonk.deadMethod
			count: 2
			path: ../../Classes/Controller/SwaggerUiController.php
