includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	scanDirectories:
		- ../../vendor
		- ../../Tests/Support
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Tests/Unit
		- ../../Tests/Functional

	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/vendor (?)
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php

	type_coverage:
		constant: 0 # TODO: Set to 100, when PHP 8.3 is minimum requirement

	typo3:
		requestGetAttributeMapping:
			id: 'string'
			'routing.route': 'string'

	# tomasvotruba/cognitive-complexity 1.3.0 counts more than 1.1.1 did, so the preset limits (function 10,
	# class 40) now flag existing code. Set to the current maxima instead of refactoring working code.
	cognitive_complexity:
		class: 47
		function: 13

	# The preset enables every ergebnis/phpstan-rules check it doesn't explicitly disable. These four
	# conflict with this extension's core design rather than flagging real issues: #[Route]/#[Cache]/
	# #[Cors] and RouteRegistry are named-arg, optional-param APIs by design; the OpenApi generator
	# builds its schema/response maps via by-reference accumulator parameters; and JsonSchemaMapper
	# deliberately suppresses the warning from probing a route requirement regex for validity.
	ergebnis:
		noNamedArgument:
			enabled: false
		noConstructorParameterWithDefaultValue:
			enabled: false
		noParameterPassedByReference:
			enabled: false
		noErrorSuppression:
			enabled: false

	# These base controllers are deliberately overridden by concrete fixtures to test route
	# inheritance (see docs/routes/route-groups.md) — marking them final would break that override.
	ignoreErrors:
		-
			identifier: ergebnis.finalInAbstractClass
			path: ../../Tests/Unit/Fixtures/*
