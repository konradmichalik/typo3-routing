includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- %rootDir%/../../shipmonk/dead-code-detector/rules.neon
	- %rootDir%/../../konradmichalik/phpstan-typo3-dead-code/rules.neon
	- ../../vendor/konradmichalik/ttt/extension.neon
	- phpstan-baseline.neon

parameters:
	level: 8

	scanDirectories:
		- ../../vendor
		- ../../Tests/Support
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../ext_localconf.php
		- ../../Tests/Unit
		- ../../Tests/Functional

	excludePaths:
		- ../../Tests/Functional/Fixtures/Extensions/*/vendor (?)
		- ../../Tests/Functional/Fixtures/Extensions/*/ext_emconf.php

	typo3:
		requestGetAttributeMapping:
			id: 'string'
			'routing.route': 'string'

	# tomasvotruba/cognitive-complexity 1.3.0 counts more than 1.1.1 did, so the preset limits (function 10,
	# class 40) now flag existing code. Set to the current maxima instead of refactoring working code.
	cognitive_complexity:
		class: 48
		function: 13

	# These base controllers are deliberately overridden by concrete fixtures to test route
	# inheritance (see docs/routes/route-groups.md) — marking them final would break that override.
	shipmonkDeadCode:
		usageExcluders:
			tests:
				enabled: true
				devPaths:
					- %currentWorkingDirectory%/../../Tests

	ignoreErrors:
		-
			identifier: ergebnis.finalInAbstractClass
			path: ../../Tests/Unit/Fixtures/*

		# Fixture controllers are reached through #[Route] reflection, which the dead code detector does not follow.
		-
			identifiers:
				- shipmonk.deadMethod
				- shipmonk.deadProperty.neverRead
				- shipmonk.deadEnumCase
			paths:
				- ../../Tests/Unit/Fixtures/*
				- ../../Tests/Functional/Fixtures/*
		-
			identifier: shipmonk.deadProperty.neverWritten
			path: ../../Tests/Unit/Fixtures/*
